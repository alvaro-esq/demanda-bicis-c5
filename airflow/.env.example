# Configuración de Airflow que depende de cada máquina.
# Copia este archivo a airflow/.env (o corre `make airflow-env`) y ajústalo.

# UID de tu usuario (`id -u`): los archivos que Airflow escribe en el repo quedan a tu nombre.
AIRFLOW_UID=50000

# Ruta absoluta del repositorio demanda-bicis-c5 en esta máquina.
PROYECTO_DIR=/ruta/a/demanda-bicis-c5

# Puerto local de la interfaz web.
AIRFLOW_PORT=8080

# Usuario administrador que crea airflow-init.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
